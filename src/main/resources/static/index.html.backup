<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TrustVault</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f6fb;color:#1e293b}.hero{background:linear-gradient(120deg,#102a43,#176b87);color:white;padding:28px 7%}.hero h1{margin:0 0 8px}.hero p{margin:0;color:#d7edf5}.wrap{max-width:1000px;margin:24px auto;padding:0 18px}.card{background:white;border-radius:14px;padding:20px;margin-bottom:18px;box-shadow:0 5px 20px #102a4310}h2{margin-top:0;font-size:20px}input,textarea,button{font:inherit;padding:10px;border-radius:8px;border:1px solid #cbd5e1}input,textarea{width:100%;margin:6px 0 12px}textarea{min-height:80px}button{background:#176b87;color:white;border:0;cursor:pointer;margin:3px}button.secondary{background:#475569}.row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.item{border:1px solid #e2e8f0;padding:12px;border-radius:10px;margin:8px 0}.muted{color:#64748b;font-size:13px}pre{white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:650px){.row{grid-template-columns:1fr}}
</style></head><body><header class="hero"><h1>🔐 TrustVault</h1><p>Secure document sharing with permission management and audit history</p></header><main class="wrap"><section class="card"><h2>Sign in</h2><p class="muted">Demo accounts: owner / Owner@123 · viewer / Viewer@123</p><label>Username</label><input id="username" value="owner"><label>Password</label><input id="password" type="password" value="Owner@123"><button onclick="login()">Sign in</button><button class="secondary" onclick="logout()">Sign out</button><span id="status" class="muted"></span></section><div class="row"><section class="card"><h2>Create a document</h2><label>Title</label><input id="title" placeholder="Document title"><label>Text content</label><textarea id="content" placeholder="Enter demo document text"></textarea><button onclick="createDoc()">Create document</button></section><section class="card"><h2>Share / revoke access</h2><label>Document ID</label><input id="docId" type="number" placeholder="For example, 1"><label>Recipient username</label><input id="recipient" value="viewer"><button onclick="shareDoc()">Grant read access</button><button class="secondary" onclick="revokeDoc()">Revoke access</button></section></div><section class="card"><h2>My accessible documents</h2><button onclick="loadDocs()">Refresh documents</button><div id="docs"></div></section><section class="card"><h2>Audit history</h2><button onclick="loadAudit()">Refresh audit</button><div id="audit"></div></section><section class="card"><h2>API overview</h2><p class="muted">REST endpoints are documented in README.md. The API uses HTTP Basic authentication in this local demo.</p></section></main><script>
let auth='';async function api(path,method='GET',body){if(!auth)throw Error('Please sign in first.');let r=await fetch('/api'+path,{method,headers:{'Authorization':'Basic '+auth,'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined});if(!r.ok){let t=await r.text();throw Error(t||('Request failed: '+r.status));}if(r.status===204)return null;return r.json()}
function login(){auth=btoa(document.getElementById('username').value+':'+document.getElementById('password').value);document.getElementById('status').textContent=' Signed in as '+document.getElementById('username').value;loadDocs().catch(showError);loadAudit().catch(showError)}function logout(){auth='';document.getElementById('status').textContent=' Signed out';document.getElementById('docs').innerHTML='';document.getElementById('audit').innerHTML=''}function showError(e){alert(e.message)}
async function createDoc(){try{let d=await api('/documents','POST',{title:title.value,content:content.value});docId.value=d.id;title.value='';content.value='';await loadDocs();await loadAudit()}catch(e){showError(e)}}async function loadDocs(){try{let a=await api('/documents');docs.innerHTML=a.map(d=>`<div class="item"><b>#${d.id} — ${esc(d.title)}</b><p>${esc(d.content)}</p><span class="muted">Owner: ${esc(d.ownerUsername)} · Created: ${new Date(d.createdAt).toLocaleString()}</span><br><button onclick="viewDoc(${d.id})">Open</button><button class="secondary" onclick="docId.value=${d.id}">Use ID</button></div>`).join('')||'<p>No documents yet.</p>'}catch(e){showError(e)}}async function viewDoc(id){try{let d=await api('/documents/'+id);alert('Document: '+d.title+'\n\n'+d.content)}catch(e){showError(e)}}async function shareDoc(){try{await api('/documents/'+docId.value+'/share','POST',{recipientUsername:recipient.value});alert('Read access granted.');await loadAudit()}catch(e){showError(e)}}async function revokeDoc(){try{await api('/documents/'+docId.value+'/share/'+encodeURIComponent(recipient.value),'DELETE');alert('Access revoked.');await loadAudit()}catch(e){showError(e)}}async function loadAudit(){try{let a=await api('/audit');audit.innerHTML=a.map(x=>`<div class="item"><b>${esc(x.action)}</b> — ${esc(x.actor)} <span class="muted">${new Date(x.eventTime).toLocaleString()}</span><p>${esc(x.details)} (Document: ${x.documentId??'—'})</p></div>`).join('')||'<p>No audit events yet.</p>'}catch(e){showError(e)}}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
</script></body></html>
